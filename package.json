{
  "name": "atoosa-flight-control",
  "version": "1.0.0",
  "type": "module",
  "description": "Modular Autonomous Flight Control Tower for Software Development",
  "scripts": {
    "start": "bun src/server/index.ts",
    "dev": "bun --watch src/server/index.ts",
    "dev:ui": "vite",
    "dev:all": "bun --watch src/server/index.ts & vite",
    "build:ui": "vite build",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "@hono/bun": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "lucide-react": "^1.57.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^8.3.4"
  }
}
