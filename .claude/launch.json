{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--watch",
        "src/server/index.ts"
      ],
      "port": 3001
    },
    {
      "name": "ui",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/.bin/vite"
      ],
      "port": 5173
    },
    {
      "name": "ui-attach",
      "url": "http://localhost:5173",
      "port": 5173
    }
  ]
}
